# ── Database ────────────────────────────────────────────────
DATABASE_URL="postgresql://calmpoint:calmpoint@localhost:5432/calmpoint"

# ── Auth (Auth.js) ──────────────────────────────────────────
AUTH_SECRET=""            # openssl rand -base64 32
AUTH_URL="http://localhost:3000"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
APPLE_CLIENT_ID=""
APPLE_CLIENT_SECRET=""

# ── Payments ────────────────────────────────────────────────
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_MEMBERSHIP_PRICE_ID=""   # optional; auto-created (lookup_key calm_point_membership_monthly) if unset

# ── Video (VideoProvider abstraction — see docs/02 D5) ──────
VIDEO_VENDOR="zoom"        # "zoom" | "daily"
ZOOM_VIDEO_SDK_KEY=""
ZOOM_VIDEO_SDK_SECRET=""
DAILY_API_KEY=""

# ── AI (all server-side only — see docs/06) ─────────────────
ANTHROPIC_API_KEY=""       # Claude — clinical analysis + safety (ensemble)
GEMINI_API_KEY=""          # Google AI Studio key (Gemini text; image gen needs billing enabled)
GOOGLE_VERTEX_PROJECT=""   # Gemini Live MUST go via Vertex AI (BAA path) before real PHI
GOOGLE_VERTEX_LOCATION="us-central1"
XAI_API_KEY=""
DEEPGRAM_API_KEY=""

# ── Comms ───────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
EMAIL_VENDOR="resend"      # "resend" | "ses"
RESEND_API_KEY=""          # resend.com — transactional email (verify a sending domain)
EMAIL_FROM="care@calmpoint.example"
SES_REGION="us-east-1"

# ── Storage ─────────────────────────────────────────────────
S3_BUCKET=""
S3_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# ── Observability / analytics ───────────────────────────────
SENTRY_DSN=""
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST=""

# ── Split-fee engine / provider monetization (docs/10 spec §2) ─
STRIPE_PROVIDER_SAAS_PRICE_ID=""   # optional; auto-created (lookup_key calm_point_provider_saas_monthly)

# ── E-prescribing seam (🚦 vendor contract + Surescripts cert required) ─
ERX_VENDOR="mock"                  # "mock" | "dosespot" | "drfirst"

# ── Insurance eligibility seam (🚦 clearinghouse enrollment required) ─
ELIGIBILITY_VENDOR="mock"          # "mock" | "changehealthcare" | "availity"

# ── Ambient scribe STT (🚦 BAA before real patient audio) ─
STT_VENDOR="mock"                  # "mock" | "grok" | "deepgram"

# ── Voice bridge (apps/voice-bridge — standalone service) ─
XAI_REALTIME_URL="wss://api.x.ai/v1/realtime"
PLATFORM_API_URL=""                # base URL of the web app, for billing lookups
PLATFORM_SERVICE_TOKEN=""          # shared secret guarding /api/v1/internal/*
